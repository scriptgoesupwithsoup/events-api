# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env НЕ публикуется в GitHub.

# Строка подключения к PostgreSQL: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
DATABASE_URL="postgresql://events_user:change_me@localhost:5432/events_db?schema=public"

# Секрет подписи JWT: не короче 32 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="1h"

PORT=3000
NODE_ENV=development

# Учётные данные администратора для seed-скрипта (только для разработки)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin12345"
SEED_USER_PASSWORD="User12345"
